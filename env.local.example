# .env.local  — copy to Vercel dashboard under Settings → Environment Variables
# These are auto-injected when you connect a Vercel Postgres database.
# You should NOT commit this file to git.

POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_USER="..."
POSTGRES_HOST="..."
POSTGRES_PASSWORD="..."
POSTGRES_DATABASE="..."
